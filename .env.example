# Howard AIOS Environment Variables
# Copy to .env and fill in actual values

# ── App ──────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
PORT=3000
HOST=0.0.0.0

# ── Database ─────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/howard_aios

# ── Redis ────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ─────────────────────────────────────
JWT_SECRET=howard-aios-dev-secret-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── AI Providers ──────────────────────────────
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
WHISPER_API_KEY=
