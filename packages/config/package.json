{
  "name": "@howard-aios/config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./eslint": "./src/eslint.ts",
    "./typescript": "./src/typescript.json",
    "./prettier": "./src/prettier.json"
  },
  "files": ["src"],
  "scripts": {
    "lint": "eslint src/",
