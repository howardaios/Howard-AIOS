{
  "name": "@howard-aios/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@howard-aios/types": "workspace:*",
    "@howard-aios/utils": "workspace:*",
    "@howard-aios/database": "workspace:*",
    "@howard-aios/information": "workspace:*",
    "@howard-aios/inbox": "workspace:*",
    "@howard-aios/meeting": "workspace:*",
    "@howard-aios/upload": "workspace:*",
    "@howard-aios/ocr": "workspace:*",
    "@howard-aios/speech": "workspace:*",
    "@howard-aios/search": "workspace:*",
    "fastify": "^5.4.0",
    "@fastify/cors": "^11.0.1",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.2",
    "zod": "^3.25.67",
    "@howard-aios/pipeline": "workspace:*",
    "@howard-aios/ai": "workspace:*",
    "@howard-aios/knowledge": "workspace:*",
    "@howard-aios/auth": "workspace:*",
    "@howard-aios/rbac": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.20.3",
    "vitest": "^3.2.4",
    "typescript": "^5.8.3"
  }
}
